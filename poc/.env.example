# Copy this file to .env and fill in the four values below.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit it — a Databricks token is a live credential
# to your workspace, and an OpenAI key is attached to your billing.

# --- Databricks -----------------------------------------------------------
# Hostname and HTTP path: in Databricks, go to SQL Warehouses, click your
# warehouse, then the "Connection details" tab. Both values are on that page.
# Make sure the warehouse is RUNNING — a stopped one takes a few minutes to
# start, and until it does the first query will just seem to hang.
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx

# Token: Settings -> Developer -> Access tokens -> Generate new token.
# Copy it immediately; it is shown only once.
DATABRICKS_TOKEN=dapi...

# --- OpenAI ---------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
#
# A new account needs a payment method with credit on it before the API will
# respond. Without one, the first call fails with "insufficient_quota" — which
# reads like a rate limit but means "add billing". A few dollars is plenty;
# this whole project costs well under that.
OPENAI_API_KEY=sk-...

# --- Optional (sensible defaults; you can ignore these) -------------------
# The model used. If you get "model_not_found", this is the knob to turn —
# see https://platform.openai.com/docs/models for what your account can use.
# OPENAI_MODEL=gpt-5.6

# The table the assistant answers questions about.
# DATABRICKS_TABLE=samples.nyctaxi.trips

# --- Stage 2 only ---------------------------------------------------------
# Set this after running notebooks/02_chunk_documents.py, to the table it
# created — the same catalog and schema you set at the top of that notebook.
# DATABRICKS_CHUNKS_TABLE=workspace.default.handbook_chunks
